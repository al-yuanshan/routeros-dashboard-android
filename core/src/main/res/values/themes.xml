<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Monitor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/monitor_window_background</item>
        <item name="android:colorBackground">@color/monitor_window_background</item>
    </style>

    <!-- Premium Dark Blue Splash Screen Theme -->
    <style name="Theme.Monitor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B0F19</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Monitor</item>
    </style>
</resources>